{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node --version",
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": ".vercel-static",
  "rewrites": [
    { "source": "/", "destination": "/api/gateway?path=/" },
    {
      "source": "/api/meeting",
      "destination": "/api/gateway?path=/api/meeting"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/api/gateway?path=/manifest.webmanifest"
    },
    {
      "source": "/icons/icon-192.png",
      "destination": "/api/gateway?path=/icons/icon-192.png"
    },
    {
      "source": "/icons/icon-512.png",
      "destination": "/api/gateway?path=/icons/icon-512.png"
    },
    {
      "source": "/icons/icon-maskable-512.png",
      "destination": "/api/gateway?path=/icons/icon-maskable-512.png"
    },
    {
      "source": "/icons/apple-touch-icon.png",
      "destination": "/api/gateway?path=/icons/apple-touch-icon.png"
    },
    {
      "source": "/_next/static/:path*",
      "destination": "https://when-we-meet-yangpa.stopjung1025.chatgpt.site/_next/static/:path*"
    },
    {
      "source": "/app-logo.png",
      "destination": "https://when-we-meet-yangpa.stopjung1025.chatgpt.site/app-logo.png"
    },
    {
      "source": "/favicon.svg",
      "destination": "https://when-we-meet-yangpa.stopjung1025.chatgpt.site/favicon.svg"
    }
  ]
}
